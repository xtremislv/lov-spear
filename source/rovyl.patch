new file mode 100644
index 0000000..53e3007
--- /dev/null
+++ b/src/lovspearMotion.ts
@@ -0,0 +1,46 @@
+import { useCallback, useEffect, useState } from 'react';
+import type { LovSpearMotion, LovSpearPrefs } from './types';
+
+/** Lov-Spear's default motion: the Tangerine-style citrus spin with the hub logo turning. */
+export const DEFAULT_MOTION: LovSpearMotion = {
+  wheelAnimation: 'citrus',
+  wheelSpeed: 'normal',
+  hubSpin: 'always',
+  hoverGlow: true,
+};
+
+export const SPEED_FACTOR: Record<LovSpearMotion['wheelSpeed'], number> = { snappy: 0.6, normal: 1, relaxed: 1.55 };
+
+/** Live wheel-motion settings, shared with Lov-Spear's file wheels through the main process. */
+export function useLovSpearMotion(): [LovSpearMotion, (patch: Partial<LovSpearMotion>) => void] {
+  const [motion, setMotionState] = useState<LovSpearMotion>(DEFAULT_MOTION);
+  useEffect(() => {
+    let alive = true;
+    void window.electron?.getMotion?.().then((m) => { if (alive && m) setMotionState(m); });
+    const off = window.electron?.onMotion?.((m) => setMotionState(m));
+    return () => { alive = false; off?.(); };
+  }, []);
+  const update = useCallback((patch: Partial<LovSpearMotion>) => {
+    setMotionState((current) => ({ ...current, ...patch }));
+    void window.electron?.setMotion?.(patch).then((m) => { if (m) setMotionState(m); });
+  }, []);
+  return [motion, update];
+}
+
+export const DEFAULT_PREFS: LovSpearPrefs = { hideWelcome: false, pinWheel: false, wheelLayout: 'merged', startWithWindows: false, language: 'en' };
+
+/** The file app's welcome options (shared settings.json), live. */
+export function useLovSpearPrefs(): [LovSpearPrefs, (patch: Partial<LovSpearPrefs>) => void] {
+  const [prefs, setPrefsState] = useState<LovSpearPrefs>(DEFAULT_PREFS);
+  useEffect(() => {
+    let alive = true;
+    void window.electron?.getPrefs?.().then((p) => { if (alive && p) setPrefsState(p); });
+    const off = window.electron?.onPrefs?.((p) => setPrefsState(p));
+    return () => { alive = false; off?.(); };
+  }, []);
+  const update = useCallback((patch: Partial<LovSpearPrefs>) => {
+    setPrefsState((current) => ({ ...current, ...patch }));
+    void window.electron?.setPrefs?.(patch).then((p) => { if (p) setPrefsState(p); });
+  }, []);
+  return [prefs, update];
+}
