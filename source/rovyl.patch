+import React from 'react';
+import { RovylLogo } from './RovylLogo';
+
+/**
+ * Lov-Spear's welcome page, shown at the top of Settings → Welcome. It replaces the file app's separate welcome
+ * window: the instructions live here, and the welcome options are the rows below it.
+ */
+const STEPS: Array<{ n: string; title: string; keys: string[]; text: string }> = [
+  {
+    n: '1', title: 'Convert files', keys: ['Drag', 'Shift'],
+    text: 'Start dragging one or more files on the desktop or in File Explorer, then press Shift. Drop on a format to convert. F8 does the same.',
+  },
+  {
+    n: '2', title: 'Edit and tools', keys: ['Drag', 'Ctrl', 'Shift'],
+    text: 'Press Ctrl+Shift while dragging for the tools wheel: crop & rotate, compress, trim, merge PDFs, OCR and more. With the two-level layout, hover a category to open its second ring. F9 does the same.',
+  },
+  {
+    n: '3', title: 'Let go on an option', keys: ['Release'],
+    text: 'New files are saved next to the originals, which are never changed. Tools with settings open a small window. Esc, or letting go outside the wheel, cancels.',
+  },
+  {
+    n: '4', title: 'Launch apps', keys: ['Shift', 'Hold right-click'],
+    text: 'Anywhere on screen, hold Shift and the right mouse button, aim at an app and let go. A quick Shift+right-click still opens the normal Windows menu.',
+  },
+];
+
+export const WelcomeGuide: React.FC = () => (
+  <div className="ls-welcome">
+    <div className="ls-welcome-hero">
+      <div className="ls-welcome-mark"><RovylLogo size={56} /></div>
+      <div>
+        <h2>Welcome to Lov-Spear</h2>
+        <p>Two wheels under your cursor: one converts and edits files, the other launches your apps.</p>
+      </div>
+    </div>
+    <ol className="ls-welcome-steps">
+      {STEPS.map((step) => (
+        <li key={step.n} className="ls-welcome-step">
+          <span className="ls-welcome-n">{step.n}</span>
+          <div>
+            <div className="ls-welcome-title">
+              <b>{step.title}</b>
+              <span className="ls-welcome-keys">
+                {step.keys.map((key, i) => (
+                  <React.Fragment key={key}>
+                    {i > 0 && <i>+</i>}
+                    <kbd>{key}</kbd>
+                  </React.Fragment>
+                ))}
+              </span>
+            </div>
+            <p>{step.text}</p>
+          </div>
+        </li>
+      ))}
+    </ol>
+    <p className="ls-welcome-note">
+      Lov-Spear runs in the notification area next to the clock, with no main window. Right-click its icon for jobs,
+      recent results, watch folders, wheel order and animation. Can't see it? Click the ^ arrow on the taskbar.
+      Everything is processed on your PC; files are never uploaded.
+    </p>
+  </div>
+);
