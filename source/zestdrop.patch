diff --git a/work/ZestDrop/Brand.cs b/work/ZestDrop/Brand.cs
new file mode 100644
index 0000000..68012a8
--- /dev/null
+++ b/work/ZestDrop/Brand.cs
@@ -0,0 +1,40 @@
+namespace ZestDrop;
+
+// Lov-Spear: ZestDrop's file tools and the Rovyl launcher in one app. The source keeps ZestDrop's
+// namespace and Chinese string keys; everything the user sees says Lov-Spear.
+internal static class Brand
+{
+    public const string Name = "Lov-Spear";
+    public const string ExeName = "Lov-Spear.exe";
+    // %LOCALAPPDATA%\Lov-Spear: settings, logs and the launcher profile, apart from a separate ZestDrop install.
+    public const string DataFolder = "Lov-Spear";
+
+    public static string Apply(string text) => text.Replace("ZestDrop", Name, System.StringComparison.Ordinal);
+
+    // The taskbar groups windows, and picks their icon, by AppUserModelID. Lov-Spear.exe and the launcher use the same
+    // one so they share a single Lov-Spear button: the Store package's own ID (family name + "!LovSpear", the
+    // Application Id in AppxManifest.xml), or a fixed ID for the installer and portable builds.
+    public const string DesktopAumid = "LovSpear.Desktop";
+    public static string Aumid
+    {
+        get
+        {
+            uint length = 0;
+            if (GetCurrentPackageFamilyName(ref length, null) != 122 || length == 0) return DesktopAumid;
+            var name = new char[length];
+            return GetCurrentPackageFamilyName(ref length, name) == 0 ? new string(name, 0, (int)length - 1) + "!LovSpear" : DesktopAumid;
+        }
+    }
+
+    // Outside the Store package, give this process the shared ID (a packaged process already has its package's).
+    public static void ClaimTaskbarIdentity()
+    {
+        if (Aumid == DesktopAumid)
+            try { SetCurrentProcessExplicitAppUserModelID(DesktopAumid); } catch (System.EntryPointNotFoundException) { }
+    }
+
+    [System.Runtime.InteropServices.DllImport("kernel32.dll", CharSet = System.Runtime.InteropServices.CharSet.Unicode)]
+    private static extern int GetCurrentPackageFamilyName(ref uint length, char[]? name);
+    [System.Runtime.InteropServices.DllImport("shell32.dll", CharSet = System.Runtime.InteropServices.CharSet.Unicode)]
+    private static extern int SetCurrentProcessExplicitAppUserModelID(string id);
+}
