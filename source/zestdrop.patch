diff --git a/work/ZestDrop/RovylHost.cs b/work/ZestDrop/RovylHost.cs
new file mode 100644
index 0000000..a480c8c
--- /dev/null
+++ b/work/ZestDrop/RovylHost.cs
@@ -0,0 +1,183 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace ZestDrop;
+
+// Runs the bundled Rovyl radial launcher next to ZestDrop, so the two behave as one app:
+//   drag + Shift / Ctrl+Shift  -> ZestDrop format / tools wheel
+//   Shift + hold right-click   -> Rovyl launcher wheel
+// Rovyl is an Electron app (GPL-3.0); the build places it in "launcher\" beside Lov-Spear.exe.
+// ZestDrop owns the tray and the lifetime: it starts Rovyl with ROVYL_EMBEDDED=1 (no second tray icon,
+// no self-updater, Shift+right trigger by default), restarts it if it crashes, and asks it to quit
+// cleanly with "--quit" so Rovyl can flush its settings.
+internal sealed class RovylHost : IDisposable
+{
+    public const string EnabledKey = "rovylLauncher";
+    private const int MaxRestarts = 5;
+    private static readonly TimeSpan RestartWindow = TimeSpan.FromMinutes(2);
+
+    private readonly object sync = new();
+    private Process? process;
+    private bool stopping, disposed;
+    private int restarts;
+    private DateTime firstRestart = DateTime.MinValue;
+
+    public static string ExePath =>
+        Environment.GetEnvironmentVariable("ZESTDROP_ROVYL_EXE") is { Length: > 0 } custom
+            ? custom
+            : Path.Combine(AppContext.BaseDirectory, "launcher", "Lov-Spear Launcher.exe");
+
+    public static bool Available => File.Exists(ExePath);
+
+    public static bool Enabled => Settings.GetBool(EnabledKey, true);
+
+    // A profile of its own, so a separately installed Rovyl (which uses %APPDATA%\Rovyl and its own
+    // single-instance lock) never fights with the embedded one.
+    private static string UserDataPath => Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), Brand.DataFolder, "launcher");
+
+    public bool Running
+    {
+        get { lock (sync) return process is { HasExited: false }; }
+    }
+
+    public void Start()
+    {
+        lock (sync)
+        {
+            if (disposed || !Available || !Enabled || process is { HasExited: false })
+                return;
+            stopping = false;
+            try
+            {
+                var started = Process.Start(StartInfo());
+                if (started == null)
+                    return;
+                started.EnableRaisingEvents = true;
+                started.Exited += OnExited;
+                process = started;
+                Journal.Write("RovylStarted", new { pid = started.Id });
+            }
+            catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
+            {
+                Journal.Write("RovylStartFailed", new { ex.Message });
+            }
+        }
+    }
+
+    public void Stop()
+    {
+        Process? running;
+        lock (sync)
+        {
+            stopping = true;
+            running = process;
+            process = null;
+        }
+        if (running == null)
+            return;
+        try
+        {
+            if (!running.HasExited)
+            {
+                // Ask the running instance to quit through its single-instance channel; it flushes config first.
+                try
+                {
+                    using var quit = Process.Start(StartInfo("--quit"));
+                    quit?.WaitForExit(3000);
+                }
+                catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException) { }
+                if (!running.WaitForExit(5000))
+                    running.Kill(true);
+            }
+        }
+        catch (InvalidOperationException) { }
+        finally
+        {
+            running.Dispose();
+            Journal.Write("RovylStopped");
+        }
+    }
+
+    public void SetEnabled(bool enabled)
+    {
+        Settings.Set(EnabledKey, enabled);
+        if (enabled) { lock (sync) { restarts = 0; } Start(); }
+        else Task.Run(Stop);
+    }
+
+    // Opens Rovyl's own hub (apps, workspaces, trigger button). A second launch of Rovyl.exe is routed to
+    // the running instance, which opens its settings.
+    // welcome: open on the Welcome page (instructions and welcome options), which replaces the old welcome window.
+    public void OpenSettings(bool welcome = false)
+    {
+        if (!Available)
+            return;
+        bool wasRunning = Running;
+        if (!wasRunning)
+        {
+            if (!Enabled) Settings.Set(EnabledKey, true);
+            Start();
+        }
+        _ = Task.Run(async () =>
+        {
+            if (!wasRunning)
+                await Task.Delay(2500).ConfigureAwait(false);
+            try { using var _ = Process.Start(StartInfo(welcome ? "--welcome" : null)); }
+            catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
+            { Journal.Write("RovylSettingsFailed", new { ex.Message }); }
+        });
+    }
+
+    private static ProcessStartInfo StartInfo(string? argument = null)
+    {
+        var info = new ProcessStartInfo(ExePath)
+        {
+            UseShellExecute = false,
+            WorkingDirectory = Path.GetDirectoryName(ExePath)!,
+        };
+        if (argument != null)
+            info.ArgumentList.Add(argument);
+        info.Environment["ROVYL_EMBEDDED"] = "1";
+        info.Environment["ROVYL_PARENT_PID"] = Environment.ProcessId.ToString(System.Globalization.CultureInfo.InvariantCulture);
+        info.Environment["ROVYL_USER_DATA"] = UserDataPath;
+        // The launcher reads (and writes) the shared wheel-motion keys here.
+        info.Environment["LOVSPEAR_SETTINGS"] = Settings.FilePath;
+        // Same taskbar identity as Lov-Spear.exe, so the settings window shows the Lov-Spear icon, never Rovyl's.
+        info.Environment["LOVSPEAR_AUMID"] = Brand.Aumid;
+        return info;
+    }
+
+    private void OnExited(object? sender, EventArgs e)
+    {
+        bool restart;
+        lock (sync)
+        {
+            if (sender is Process exited && exited != process)
+                return;
+            process?.Dispose();
+            process = null;
+            restart = !stopping && !disposed && Enabled;
+            if (restart)
+            {
+                var now = DateTime.UtcNow;
+                if (now - firstRestart > RestartWindow) { firstRestart = now; restarts = 0; }
+                restart = ++restarts <= MaxRestarts;
+            }
+        }
+        Journal.Write("RovylExited", new { restart });
+        if (restart)
+            _ = Task.Delay(1500).ContinueWith(_ => Start(), TaskScheduler.Default);
+    }
+
+    public void Dispose()
+    {
+        if (disposed)
+            return;
+        Stop();
+        disposed = true;
+    }
+}
