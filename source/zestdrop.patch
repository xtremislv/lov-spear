+++ b/work/ZestDrop/WheelMotion.cs
@@ -0,0 +1,46 @@
+using System;
+
+namespace ZestDrop;
+
+// How the wheels move. Shared with the bundled launcher: both read these keys from settings.json, so one choice in
+// the tray (or in the launcher's settings) styles both wheels.
+internal enum WheelStyle { Bloom, Citrus, Cascade, Pop, None }
+internal enum HubSpin { Off, Once, Always }
+
+internal static class WheelMotion
+{
+    public const string StyleKey = "wheelAnimation", SpeedKey = "wheelSpeed", SpinKey = "hubSpin", GlowKey = "hoverGlow";
+
+    // Citrus (inspired by Tangerine's spinning-slice splash) is Lov-Spear's signature, so it is the default.
+    public static WheelStyle Style => Settings.GetString(StyleKey) switch
+    {
+        "bloom" => WheelStyle.Bloom,
+        "cascade" => WheelStyle.Cascade,
+        "pop" => WheelStyle.Pop,
+        "none" => WheelStyle.None,
+        _ => WheelStyle.Citrus
+    };
+
+    public static string Speed => Settings.GetString(SpeedKey) is "snappy" or "relaxed" ? Settings.GetString(SpeedKey)! : "normal";
+
+    // Multiplies every duration and delay.
+    public static double SpeedFactor => Speed switch { "snappy" => .6, "relaxed" => 1.55, _ => 1 };
+
+    public static HubSpin Spin => Settings.GetString(SpinKey) switch { "off" => HubSpin.Off, "once" => HubSpin.Once, _ => HubSpin.Always };
+
+    public static bool Glow => Settings.GetBool(GlowKey, true);
+
+    // Windows' "Animation effects" switch (Accessibility > Visual effects) turns all of it off.
+    public static bool SystemAllowsMotion
+    {
+        get
+        {
+            try { return System.Windows.SystemParameters.ClientAreaAnimation; }
+            catch (InvalidOperationException) { return true; }
+        }
+    }
+
+    public static WheelStyle Effective => SystemAllowsMotion ? Style : WheelStyle.None;
+
+    public static string Name(WheelStyle style) => style.ToString().ToLowerInvariant();
+}
