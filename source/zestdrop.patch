@@ -0,0 +1,73 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Threading.Tasks;
+
+namespace ZestDrop;
+
+// Store (MSIX) builds start with Windows through the package's StartupTask, which only the WinRT
+// Windows.ApplicationModel.StartupTask API can switch on or off. Lov-Spear is built without the Windows SDK projection,
+// so it asks Windows PowerShell (which speaks WinRT natively) to make that call. A child process of a packaged app runs
+// with the package's identity, so the task it sees is Lov-Spear's own.
+internal sealed class PackagedStartupShellProvider : IStartupProvider
+{
+    private const string Script = """
+        $ErrorActionPreference = 'Stop'
+        Add-Type -AssemblyName System.Runtime.WindowsRuntime
+        $asTask = [System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object {
+            $_.Name -eq 'AsTask' -and $_.IsGenericMethod -and $_.GetParameters().Count -eq 1 -and
+            $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' } | Select-Object -First 1
+        function Await($operation, [Type]$type) {
+            $task = $asTask.MakeGenericMethod($type).Invoke($null, @($operation))
+            [void]$task.Wait(-1)
+            $task.Result
+        }
+        $null = [Windows.ApplicationModel.StartupTask, Windows.ApplicationModel, ContentType = WindowsRuntime]
+        $startup = Await ([Windows.ApplicationModel.StartupTask]::GetAsync('__TASK__')) ([Windows.ApplicationModel.StartupTask])
+        switch ('__ACTION__') {
+            'enable'  { $state = Await ($startup.RequestEnableAsync()) ([Windows.ApplicationModel.StartupTaskState]) }
+            'disable' { $startup.Disable(); $state = $startup.State }
+            default   { $state = $startup.State }
+        }
+        Write-Output "STATE=$state"
+        """;
+
+    private static StartupStatus Status(string state) => state switch
+    {
+        "Enabled" => new(true),
+        "EnabledByPolicy" => new(true, false, L.T("开机自启由 Windows 系统策略管理。")),
+        "DisabledByPolicy" => new(false, false, L.T("开机自启由 Windows 系统策略管理。")),
+        "DisabledByUser" => new(false, false, L.T("Windows 已禁用自启，请在系统启动应用设置中更改。")),
+        _ => new(false)
+    };
+
+    public Task<StartupStatus> GetAsync() => Run("get");
+
+    public Task<StartupStatus> SetAsync(bool enabled) => Run(enabled ? "enable" : "disable");
+
+    private static async Task<StartupStatus> Run(string action)
+    {
+        string script = Script.Replace("__TASK__", StartupManager.TaskId).Replace("__ACTION__", action);
+        string powershell = Path.Combine(Environment.SystemDirectory, "WindowsPowerShell", "v1.0", "powershell.exe");
+        var info = new ProcessStartInfo(powershell)
+        {
+            UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true,
+        };
+        foreach (string argument in new[] { "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-EncodedCommand",
+                     Convert.ToBase64String(System.Text.Encoding.Unicode.GetBytes(script)) })
+            info.ArgumentList.Add(argument);
+        using var process = Process.Start(info) ?? throw new IOException("powershell.exe did not start.");
+        var output = process.StandardOutput.ReadToEndAsync();
+        var error = process.StandardError.ReadToEndAsync();
+        if (!process.WaitForExit(15000))
+        {
+            try { process.Kill(true); } catch (InvalidOperationException) { }
+            throw new TimeoutException("Windows did not answer in time.");
+        }
+        string text = await output.ConfigureAwait(false);
+        int at = text.LastIndexOf("STATE=", StringComparison.Ordinal);
+        if (at < 0)
+            throw new IOException((await error.ConfigureAwait(false)).Trim() is { Length: > 0 } message ? message : "No answer from Windows.");
+        return Status(text[(at + 6)..].Trim());
+    }
+}
