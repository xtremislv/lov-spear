+    // CSS-style cubic-bezier timing (the curves Rovyl's wheel uses), for WPF animations.
+    private sealed class CubicBezierEase(double x1, double y1, double x2, double y2) : IEasingFunction
+    {
+        public double Ease(double t)
+        {
+            if (t <= 0) return 0;
+            if (t >= 1) return 1;
+            double u = t;
+            for (int i = 0; i < 8; i++)
+            {
+                double x = Bezier(u, x1, x2) - t, slope = Slope(u, x1, x2);
+                if (Math.Abs(x) < 1e-5) break;
+                if (Math.Abs(slope) < 1e-6) break;
+                u = Math.Clamp(u - x / slope, 0, 1);
+            }
+            return Bezier(u, y1, y2);
+        }
+
+        private static double Bezier(double u, double a, double b) => 3 * a * u * (1 - u) * (1 - u) + 3 * b * u * u * (1 - u) + u * u * u;
+        private static double Slope(double u, double a, double b) => 3 * a * (1 - u) * (1 - u) + 6 * (b - a) * u * (1 - u) + 3 * (1 - b) * u * u;
+    }
